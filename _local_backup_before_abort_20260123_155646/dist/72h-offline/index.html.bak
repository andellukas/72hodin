<!doctype html>
<html lang="cs">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>72 hodin – offline poradce</title>
<link rel="icon" href="icons/icon.svg">
<link rel="manifest" href="manifest.webmanifest">
<meta name="theme-color" content="#003a8f">
<style>
:root{
  --bg:#f6f7f9; --text:#111; --muted:#555;
  --card:#fff; --border:#e7e7e7;
  --blue:#003a8f; --blue2:#0b5bd3;
  --warn:#fff7e6; --warnBorder:#f1d08a;
  --urgent:#fff1f1; --urgentBorder:#f1b2b2;
  --shadow:0 2px 6px rgba(0,0,0,.08);
  --r:18px;
}
*{box-sizing:border-box}
body{font-family:system-ui,Arial;margin:0;background:var(--bg);color:var(--text)}
header{background:var(--blue);color:#fff;padding:18px 20px}
main{max-width:1040px;margin:auto;padding:18px}
h1{margin:0;font-size:22px}
.small{color:var(--muted);font-size:13px}
.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-top:10px}
input{width:100%;padding:16px;font-size:18px;border:1px solid #ccc;border-radius:14px}
.btn{border:1px solid rgba(0,0,0,.12); background:#fff; color:#123; padding:10px 14px; border-radius:999px; cursor:pointer; font-weight:900;}
.btn:hover{background:#f3f6ff;border-color:#cbd6ff}
.btnPrimary{background:var(--blue2);color:#fff;border-color:transparent}
.card{background:var(--card);border:1px solid var(--border);border-radius:var(--r);box-shadow:var(--shadow);padding:14px 14px;margin:12px 0}
.q{font-weight:900;font-size:18px;line-height:1.25}
.box{background:#eef5ff;border:1px solid #cfe0ff;border-radius:14px;padding:12px;margin-top:10px}
.box h3{margin:0 0 6px 0;font-size:14px;text-transform:uppercase;letter-spacing:.06em}
.box.warn{background:var(--warn);border-color:var(--warnBorder)}
.box.urgent{background:var(--urgent);border-color:var(--urgentBorder)}
.tag{display:inline-block;background:#eef1f7;border:1px solid #d9deea;border-radius:999px;padding:4px 10px;margin:6px 6px 0 0;font-size:12px}
#panicGrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:12px}
.panicBtn{padding:14px;border-radius:16px;border:1px solid #cbd6ff;background:#fff;font-weight:900;cursor:pointer}
.panicBtn:hover{background:#f3f6ff}
#sug{display:none;margin-top:8px}
.sugBtn{display:block;width:100%;text-align:left;border:1px solid #e2e6f2;background:#fff;padding:10px 12px;border-radius:12px;margin:6px 0;cursor:pointer}
.sugBtn:hover{background:#f6f8ff}
#dym{display:none;margin-top:10px;color:#333}
.dymBtn{border:0;background:#0b5bd3;color:#fff;padding:6px 10px;border-radius:10px;cursor:pointer;font-weight:900}
</style>
</head>
<body>
<header>
  <div style="display:flex;justify-content:space-between;gap:10px;align-items:flex-start">
    <div>
      <h1>72 hodin – offline poradce</h1>
      <div class="small">Offline: <b id="net">?</b> • Vyhledávání bez diakritiky a s překlepy • PANIKA/PLNO</div>
    </div>
    <div class="row" style="margin-top:0">
      <button class="btn btnPrimary" id="toggle">PANIKA: ZAP</button>
      <button class="btn" id="all">Vymazat</button>
    </div>
  </div>
</header>

<main>
  <input id="q" placeholder="Napiš dotaz (např. 'netece voda', 'eletrika', 'sirema', 'bankomat')" autocomplete="off" />
  <div id="sug"></div>
  <div id="dym" class="small"></div>

  <div id="panicCard" class="card">
    <div class="q">Rychlé volby (PANIKA)</div>
    <div id="panicGrid"></div>
    <div class="small" style="margin-top:10px">Tip: napiš klidně bez diakritiky. Překlepy typu „eletrika“, „sirema“ se snažíme pochopit.</div>
  </div>

  <div id="r"></div>
</main>
<div id="cov" style="display:none"></div>
  <script defer src="app.js"></script>
</body>
</html>
